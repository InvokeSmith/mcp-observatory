node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
*.pem

# Constraint 7, and the half of constraint 6 that is easy to get wrong.
#
# Only the REPORT tier is publishable. Everything else under data/ names names:
#
#   data/discover/   candidate hostnames. A list of organizations running MCP
#                    servers is a targeting list in aggregate form, whatever it
#                    is called, and it is an input rather than a finding.
#   data/runs/       raw captures: full response bodies and headers. Personal-data
#                    adjacent and commercially sensitive. Retention-swept.
#   data/snapshots/  tool names and schemas as declared. The k-anonymity
#                    suppression that makes a tool name safe to publish happens at
#                    REPORT time, not at seal time, so a snapshot still holds names
#                    that identify a single organization.
#   data/state/      durable host state, keyed by hostname.
#
# data/reports/ is the linted, suppressed, aggregate output. That is what ships.
data/*
!data/reports/

# Handoff artifact from scripts/setup-pgp-key.sh. The fingerprint's home is
# src/config/identity.ts and the documents; a second copy that can drift is
# worse than none. The public key itself IS committed.
security/*.fingerprint
