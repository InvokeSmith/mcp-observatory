{
  "name": "mcp-observatory",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "private": true,
  "description": "A passive posture survey of publicly reachable MCP servers. Observation only: it never invokes a tool.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "research",
    "survey",
    "tool-schemas"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invokesmith/mcp-observatory.git"
  },
  "bugs": {
    "url": "https://github.com/invokesmith/mcp-observatory/issues"
  },
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "observatory": "src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "observatory": "bun run src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
